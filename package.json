{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "init:project": "bash scripts/local/bootstrap.sh",
    "local:bootstrap": "bash scripts/local/bootstrap.sh",
    "local:up": "bash scripts/local/up.sh",
    "build": "vite build",
    "dev": "vite",
    "dev:full": "bash scripts/local/up.sh",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "docker:bootstrap": "bash scripts/docker/bootstrap.sh",
    "docker:up": "bash scripts/docker/up.sh",
    "docker:down": "bash scripts/docker/down.sh",
    "docker:logs": "bash scripts/docker/logs.sh",
    "docker:test": "bash scripts/docker/test.sh",
    "docker:seed": "bash scripts/docker/seed.sh"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "laravel-vite-plugin": "^3.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/react": "^3.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.2"
  }
